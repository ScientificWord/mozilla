#include<winver.h>

#include <windows.h>
 
/////////////////////////////////////////////////////////////////////////////
//
// Version
//

1 VERSIONINFO
 FILEVERSION 0,0,0,1
 PRODUCTVERSION 0,0,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRIVATEBUILD | VS_FF_DEBUG
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "Comments",         ""
            VALUE "LegalCopyright",   "Copyright 2006 by MacKichan Software, Inc."
            VALUE "CompanyName",      "MacKichan Software, Inc."
            VALUE "FileDescription",  "MuPAD Wrapper DLL from Jack"
            VALUE "FileVersion",      ""
            VALUE "ProductVersion",   ""
            VALUE "InternalName",     "Prince"
            VALUE "LegalTrademarks",  "Scientific WorkPlace, Scientific Word, Scientific Notebook copyright MacKichan Software, Inc."
            VALUE "OriginalFilename", "MuPWrapperDLL.dll"

            VALUE "PrivateBuild",     ""

            VALUE "ProductName",      "Scientific WorkPlace and related"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END

