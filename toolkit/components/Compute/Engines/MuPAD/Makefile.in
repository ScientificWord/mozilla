DEPTH		= ../../../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

MODULE = compute
MODULE_NAME = computeModule
LIBRARY_NAME	= mupwrapperlib_s
LIBXUL_LIBRARY = 1

REQUIRES = compute \
           string \
           xpcom \
		   $(NULL)

include $(topsrcdir)/config/config.mk

CPPSRCS =				\
  MuAnalyzer.cpp \
  mupd_eng.cpp \
  MuP2Tree.cpp \
  MuWrap.cpp \
  MuWrapPlotCmd.cpp \
  MuPADPlot.cpp \
	$(NULL)

# we don't want the shared lib, but we want to force the creation of a static lib.
FORCE_STATIC_LIB = 1

LOCAL_INCLUDES = -I$(srcdir)/../../libtci	\
			-I$(srcdir)/../../Engines	\
      -I$(srcdir)/../../computelib \
      -I$(srcdir)/../../compsample2 \
	    -I$(srcdir)/../../public \
			$(NULL)

include $(topsrcdir)/config/rules.mk

