#include<winver.h>

#include <windows.h>
 
/////////////////////////////////////////////////////////////////////////////
//
// Version
//

1 VERSIONINFO
 FILEVERSION 0,0,0,1
 PRODUCTVERSION 0,0,0,1
 FILEFLAGSMASK 0x3fL
 FILEFLAGS VS_FF_PRIVATEBUILD | VS_FF_DEBUG
 FILEOS VOS__WINDOWS32
 FILETYPE VFT_DLL
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "Comments",         "Hi"
            VALUE "LegalCopyright",   "Prototype"
            VALUE "CompanyName",      "MacKichan Software, Inc."
            VALUE "FileDescription",  "Maple V Wrapper DLL from Jack"
            VALUE "FileVersion",      "Personal Debug"
            VALUE "ProductVersion",   "Personal Debug"
            VALUE "InternalName",     "Prince"
            VALUE "LegalTrademarks",  "Scientific WorkPlace, etc."
            VALUE "OriginalFilename", "MplWrapperDLL.dll"

            VALUE "PrivateBuild",     ""

            VALUE "ProductName",      "Prince"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END

