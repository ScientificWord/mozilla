;Test script for "Comptest.exe".

SetClientPref     1,use_mfenced,1

;This section from TestEvaluate.xhtml
Test ID     101
Comment     inert
Client ID   1
Engine      MuPAD
Command ID	Interpret
   <math xmlns="http://www.w3.org/1998/Math/MathML">
     <mrow>
       <mn>3</mn>
       <mo form="infix">&minus;</mo>
       <mn>4</mn>
     </mrow>
   </math>
End of test

Test ID     102
Comment     should build mfrac
Client ID   1
Engine      MuPAD
Command ID	Interpret
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mrow>
       <mrow>
         <mi mathcolor="gray">sin</mi>
         <mo>&ApplyFunction;</mo>
         <mi>a</mi>
       </mrow>
       <mo form="infix">/</mo>
       <mrow>
         <mi mathcolor="gray">sin</mi>
         <mo>&ApplyFunction;</mo>
         <mi>b</mi>
       </mrow>
     </mrow>
   </math>
End of test

