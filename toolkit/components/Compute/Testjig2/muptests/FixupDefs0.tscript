;Test script for "Comptest.exe". Roughly based on TestDefines.xml
; This version is mostly straight from SWP export.

SetClientPref     1,use_mfenced,1

; Somewhat questionable.  How does SWP know f is a function?
Test ID     101 eval before define (ApplyFunction)
Client ID   1
Engine      MuPAD
Command ID	Evaluate
   <mml:math display="inline">
     <mml:mrow>
       <mml:mi>f</mml:mi>
       <mml:mo>&ApplyFunction;</mml:mo>
       <mml:mrow>
         <mml:mo form="prefix" fence="true" stretchy="false">(</mml:mo>
         <mml:mn>5</mml:mn>
         <mml:mo form="postfix" fence="true" stretchy="false">)</mml:mo>
       </mml:mrow>
     </mml:mrow>
   </mml:math>
End of test

; Default interpretation
Test ID     101 eval before define (InvisibleTimes)
Client ID   1
Engine      MuPAD
Command ID	Evaluate
   <mml:math display="inline">
     <mml:mrow>
       <mml:mi>f</mml:mi>
       <mml:mo>&InvisibleTimes;</mml:mo>
       <mml:mrow>
         <mml:mo form="prefix" fence="true" stretchy="false">(</mml:mo>
         <mml:mn>5</mml:mn>
         <mml:mo form="postfix" fence="true" stretchy="false">)</mml:mo>
       </mml:mrow>
     </mml:mrow>
   </mml:math>
End of test

Test ID     101 define
Comment     define f(m) = 1/(1+m)
Client ID   1
Engine      MuPAD
Command ID	Define
   <mml:math display="inline">
     <mml:mrow>
       <mml:mrow>
         <mml:mi>f</mml:mi>
         <mml:mo>&ApplyFunction;</mml:mo>
         <mml:mrow>
           <mml:mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mml:mo>
           <mml:mi>m</mml:mi>
           <mml:mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mml:mo>
         </mml:mrow>
       </mml:mrow>
       <mml:mo form="infix">=</mml:mo>
       <mml:mfrac>
         <mml:mn>1</mml:mn>
         <mml:mrow>
           <mml:mn>1</mml:mn>
           <mml:mo form="infix">+</mml:mo>
           <mml:mi>m</mml:mi>
         </mml:mrow>
       </mml:mfrac>
     </mml:mrow>
   </mml:math>
End of test

