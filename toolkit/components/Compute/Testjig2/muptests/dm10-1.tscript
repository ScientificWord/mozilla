;Script to set initial engine state

SetEngineState    MuPAD,SeriesOrder,5
SetEngineState    MuPAD,Digits,10
SetEngineState    MuPAD,MaxDegree,4
SetEngineState    MuPAD,PvalOnly,0
SetEngineState    MuPAD,IgnoreSCases,0

SetClientPref     1,use_mfenced,1
SetClientPref     0,Output_differentiald,0
SetClientPref     0,Output_ln_base,0
SetClientPref     0,Output_imaginaryi,0

