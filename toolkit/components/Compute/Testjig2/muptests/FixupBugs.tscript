;Test script for "Comptest.exe".
;
;Bugs and other fringe cases.

SetClientPref     1,use_mfenced,1

Test ID     brokenVectorField
Comment     worst case
Client ID   1
Engine      MuPAD
Command ID	Fixup
 <math xmlns="http://www.w3.org/1998/Math/MathML">
   <msqrt>
     <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
     <mn>1</mn>
     <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
   </msqrt>
 </math>
End of test
 
Test ID     brokenVectorField
Comment     closer case
Client ID   1
Engine      MuPAD
Command ID	Fixup
 <math xmlns="http://www.w3.org/1998/Math/MathML">
   <msqrt>
     <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
     <mrow>
       <mn>1</mn>
     </mrow>
     <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
   </msqrt>
 </math>
End of test
 
Test ID     brokenVectorField.xhtml
Comment     buggy plot input
Client ID   1
Engine      MuPAD
Command ID	Fixup
 <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
   <mrow>
     <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
       <mrow>
         <mrow>
           <mstyle displaystyle="true" scriptlevel="0">
             <mfrac>
               <mn>1</mn>
               <msqrt>
                 <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
                   <mrow>
                     <mn>1</mn>
                     <mo form="infix">+</mo>
                     <msup>
                      <mrow>
                       <mo form="prefix" fence="true" stretchy="true" symmetric="true">|</mo>
                       <mrow>
                         <msup>
                           <mi>y</mi>
                           <mn>2</mn>
                         </msup>
                         <mo form="infix">-</mo>
                         <msup>
                           <mi>t</mi>
                           <mn>2</mn>
                         </msup>
                       </mrow>
                       <mo form="postfix" fence="true" stretchy="true" symmetric="true">|</mo>
                      </mrow>
                      <mn>2</mn>
                     </msup>
                   </mrow>
                 <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
               </msqrt>
             </mfrac>
           </mstyle>
         </mrow>
         <mo form="infix">,</mo>
         <mrow>
           <mstyle displaystyle="true" scriptlevel="0">
             <mfrac>
               <mrow>
                 <msup>
                   <mi>y</mi>
                   <mn>2</mn>
                 </msup>
                 <mo form="infix">-</mo>
                 <msup>
                   <mi>t</mi>
                   <mn>2</mn>
                 </msup>
               </mrow>
               <msqrt>
                 <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
                 <mrow>
                   <mn>1</mn>
                   <mo form="infix">+</mo>
                   <msup>
                     <mrow>
                       <mo form="prefix" fence="true" stretchy="true" symmetric="true">|</mo>
                       <mrow>
                         <msup>
                           <mi>y</mi>
                           <mn>2</mn>
                         </msup>
                         <mo form="infix">-</mo>
                         <msup>
                           <mi>t</mi>
                           <mn>2</mn>
                         </msup>
                       </mrow>
                       <mo form="postfix" fence="true" stretchy="true" symmetric="true">|</mo>
                     </mrow>
                     <mn>2</mn>
                   </msup>
                 </mrow>
                 <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
               </msqrt>
             </mfrac>
           </mstyle>
         </mrow>
       </mrow>
     <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
   </mrow>
 </math>
End of test

Test ID     brokenVectorField.xhtml
Comment     output from Fixup
Client ID   1
Engine      MuPAD
Command ID	Evaluate
 <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
  <mfenced ilk="enclosed-list" open="(" close=")">
    <mfrac>
      <mn>1</mn>
      <msqrt>
        <mfenced open="(" close=")">
          <mrow>
            <mn>1</mn>
            <mo form="infix">+</mo>
            <msup>
              <mfenced open="|" close="|">
                <mrow>
                  <msup>
                    <mi>y</mi>
                    <mn>2</mn>
                  </msup>
                  <mo form="infix">-</mo>
                  <msup>
                    <mi>t</mi>
                    <mn>2</mn>
                  </msup>
                </mrow>
              </mfenced>
              <mn>2</mn>
            </msup>
          </mrow>
        </mfenced>
      </msqrt>
    </mfrac>
    <mfrac>
      <mrow>
        <msup>
          <mi>y</mi>
          <mn>2</mn>
        </msup>
        <mo form="infix">-</mo>
        <msup>
          <mi>t</mi>
          <mn>2</mn>
        </msup>
      </mrow>
      <msqrt>
        <mfenced open="(" close=")">
          <mrow>
            <mn>1</mn>
            <mo form="infix">+</mo>
            <msup>
              <mfenced open="|" close="|">
                <mrow>
                  <msup>
                    <mi>y</mi>
                    <mn>2</mn>
                  </msup>
                  <mo form="infix">-</mo>
                  <msup>
                    <mi>t</mi>
                    <mn>2</mn>
                  </msup>
                </mrow>
              </mfenced>
              <mn>2</mn>
            </msup>
          </mrow>
        </mfenced>
      </msqrt>
    </mfrac>
  </mfenced>
 </math>
End of test

