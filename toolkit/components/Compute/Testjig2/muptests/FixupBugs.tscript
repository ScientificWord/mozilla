Test ID     absolute value as fence
Comment     fixup the eval result
Client ID   1
Engine      MuPAD
Command ID	Fixup
  <math xmlns="http://www.w3.org/1998/Math/MathML">
    <mrow>
      <mo>[</mo>
      <mrow>
        <mfrac>
          <mn>1</mn>
          <msqrt>
            <msup>
              <mrow>
                <mo>|</mo>
                <mrow>
                  <msup>
                    <mi>y</mi>
                    <mn>2</mn>
                  </msup>
                  <mo>&#x2212;</mo>
                  <msup>
                    <mi>t</mi>
                    <mn>2</mn>
                  </msup>
                </mrow>
                <mo>|</mo>
              </mrow>
              <mn>2</mn>
            </msup>
            <mo>+</mo>
            <mn>1</mn>
          </msqrt>
        </mfrac>
        <mo>,</mo>
        <mrow>
          <mo>&#x2212;</mo>
          <mfrac>
            <mrow>
              <mo>(</mo>
              <mrow>
                <msup>
                  <mi>t</mi>
                  <mn>2</mn>
                </msup>
                <mo>&#x2212;</mo>
                <msup>
                  <mi>y</mi>
                  <mn>2</mn>
                </msup>
              </mrow>
              <mo>)</mo>
            </mrow>
            <msqrt>
              <msup>
                <mrow>
                  <mo>|</mo>
                  <mrow>
                    <msup>
                      <mi>y</mi>
                      <mn>2</mn>
                    </msup>
                    <mo>&#x2212;</mo>
                    <msup>
                      <mi>t</mi>
                      <mn>2</mn>
                    </msup>
                  </mrow>
                  <mo>|</mo>
                </mrow>
                <mn>2</mn>
              </msup>
              <mo>+</mo>
              <mn>1</mn>
            </msqrt>
          </mfrac>
        </mrow>
      </mrow>
      <mo>]</mo>
    </mrow>
  </math>
End of test

