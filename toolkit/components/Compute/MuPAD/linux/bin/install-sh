#!/bin/sh
# Install Linux version of SWP Version 6.0
# Temporary until we get a real installer

BASE=/usr/local
INSTALLNAME=SWP-6.0
DIRNAME=swppro
LICENSEDIR=.mupadpro40
LICENSEFILE=.mupadpro40/.license

echo Installing Scientific Workplace, Version 6

CURDIR=`pwd`
if [ `basename $CURDIR` != $DIRNAME ]
then
	echo "
		You must install from the swppro directory
	"
	exit
fi
if [ `whoami` != 'root' ] 
then
	echo "
	You must install as root!
	"
	exit
fi
if [ -d $BASE/$INSTALLNAME ]
then
	rm -rf $BASE/$INSTALLNAME
	mkdir $BASE/$INSTALLNAME
else
	mkdir $BASE/$INSTALLNAME
fi
# We are root, located in the swppro directory, and
# /usr/local/SWP-6.0 exists and is empty
find . | cpio -pdm $BASE/$INSTALLNAME

RETURNDIR=`pwd`
cd $BASE/bin
if [ -e swppro ]
then
	rm swppro
fi
cat > swppro << EOF
#!/bin/sh
$BASE/SWP-6.0/swppro
EOF
chmod +x swppro
cd $RETURNDIR

if ! [ -d /home/$SUDO_USER/$LICENSEDIR ]
then
	mkdir /home/$SUDO_USER/$LICENSEDIR
	cp MuPAD/license/license /home/$SUDO_USER/$LICENSEFILE
	touch /home/$SUDO_USER/$LICENSEDIR/SWP
fi

if ! [ -d /etc/ld.so.conf.d ]
then
	mkdir /etc/ld.so.conf.d
	echo include /etc/ld.so.conf.d/*.conf >> /etc/ld.so.conf
fi
cat > /etc/ld.so.conf.d/SWP.conf << EOF
$BASE/SWP-6.0/MuPAD/linux/lib
EOF
ldconfig

echo Installation completed.
