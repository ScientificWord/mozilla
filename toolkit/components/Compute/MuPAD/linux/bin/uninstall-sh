#!/bin/sh
# Uninstall Linux version of SWP Version 6.0
# Temporary until we get a real installer

BASE=/usr/local
INSTALLNAME=SWP-6.0
DIRNAME=swppro
LICENSEDIR=.mupadpro40
LICENSEFILE=.mupadpro40/.license
PROFILEDIR=.swppro

echo Uninstalling Scientific Workplace Version 6.0
CURDIR=`pwd`
if [ `whoami` != 'root' ] 
then
	echo "
	You must uninstall as root
	"
	exit
fi

# remove /usr/local/swppro
if [ -e  $BASE/bin/swppro ]
then
	rm  $BASE/bin/swppro
fi

# remove MuPAD license
if [ -e /home/$SUDO_USER/$LICENSEDIR/SWP ]
then
	rm -rf /home/$SUDO_USER/$LICENSEDIR
fi

# remove library path
if [ -e /etc/ld.so.conf.d/SWP.conf ]
then
	rm /etc/ld.so.conf.d/SWP.conf
fi
ldconfig

# remove profile
if [ -d /home/$SUDO_USER/.swppro ]
then
	rm -rf /home/$SUDO_USER/.swppro
fi

# remove SWP code
if [ -d $BASE/$INSTALLNAME ]
then
	rm -rf $BASE/$INSTALLNAME
fi

echo Uninstall completed.


