DEPTH		= ../../../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

MODULE		    = mapleenginewrapper
XPIDL_MODULE	= mapleenginewrapper
LIBRARY_NAME	= mapleenginewrapper
SHORT_LIBNAME	= mapwrap
LIBXUL_LIBRARY = 1
MODULE_NAME	= msiMapleEngineWrapperModule


REQUIRES	= \
          compute \
          string \
		  xpcom \
		  $(NULL)

CPPSRCS		=		   \
		msiMapleEngineWrapper.cpp	   \
		msiMapleEngineWrapperModule.cpp \
		$(NULL)

include $(topsrcdir)/config/config.mk

# separate libraries linked in.
EXTRA_DSO_LDOPTS = \
      $(DIST)/lib/$(LIB_PREFIX)MplWrapperDLL_s.$(LIB_SUFFIX) \
      $(DIST)/lib/$(LIB_PREFIX)computelib_s.$(LIB_SUFFIX) \
      $(DIST)/lib/$(LIB_PREFIX)enginelib_s.$(LIB_SUFFIX) \
      $(DIST)/lib/$(LIB_PREFIX)libtci_s.$(LIB_SUFFIX) \
      $(XPCOM_GLUE_LDOPTS) \
      $(NSPR_LIBS) \
		$(NULL)

ifeq ($(OS_ARCH),WINNT)
EXTRA_LIBS += \
		ole32.lib \
		oleaut32.lib \
		oledlg.lib \
		$(NULL)
endif

ifeq ($(OS_ARCH),Darwin)
EXTRA_LIBS += \
		$(srcdir)/../../Maple/Darwin/libexpat.a \
		$(srcdir)/../../Maple/Darwin/liblibstream.a \
		$(srcdir)/../../Maple/Darwin/libmupudskernel.a \
		$(srcdir)/../../Maple/Darwin/libmut.a \
		-lz -framework Carbon \
		$(NULL)
endif

ifeq ($(OS_ARCH),Linux)
EXTRA_LIBS += \
		$(srcdir)/../../Maple/linux/libmupudskernel.a \
		$(srcdir)/../../Maple/linux/libexpat.a \
		$(srcdir)/../../Maple/linux/libmut.a \
		$(srcdir)/../../Maple/linux/liblibstream.a \
		$(srcdir)/../../Maple/linux/libz.a \
		$(NULL)
endif

include $(topsrcdir)/config/rules.mk

LOCAL_INCLUDES = -I$(srcdir)/../../libtci	\
			-I$(srcdir)/../../Engines	\
			-I$(srcdir)/../../Engines/Maple	\
            -I$(srcdir)/../../computelib \
            -I$(srcdir)/../../compsample2 \
			-I$(srcdir)/../../public \
			$(NULL)

                 