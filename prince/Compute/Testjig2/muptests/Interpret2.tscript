     <mn>9</mn>
     <mo form="infix">&minus;</mo>
     <mo form="prefix" fence="true" stretchy="false">(</mo>
     <mn>8</mn>
     <mo form="infix">&minus;</mo>
     <mo form="prefix" fence="true" stretchy="false">(</mo>
     <mrow>
       <mn>7</mn>
       <mo form="infix">&minus;</mo>
       <mn>6</mn>
     </mrow>
