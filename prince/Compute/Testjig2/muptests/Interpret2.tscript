;Test script for "Comptest.exe".

SetClientPref     1,use_mfenced,1

;Continuation of Interpret.tscript
Test ID     502a
Comment     should bind args
Client ID   1
Engine      MuPAD
Command ID	Interpret
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mi mathcolor="gray">sin</mi>
     <mi>a</mi>
     <mo form="infix">&InvisibleTimes;</mo>
     <mi>b</mi>
   </math>
End of test

