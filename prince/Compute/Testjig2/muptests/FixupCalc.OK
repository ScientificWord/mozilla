<p>
Test ID 213.3
</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mo form="prefix" largeop="true">&#x222c;</mo>
  <mrow>
    <mfenced open="(" close=")">
      <mrow>
        <mi>y</mi>
        <mo>+</mo>
        <mrow>
          <mi mathcolor="gray">sin</mi>
