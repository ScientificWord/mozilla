<h3>Integrals with various differential markups</h3>
<p>
Test ID 213.3
</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mo form="prefix" largeop="true">&#x222c;</mo>
  <mrow>
    <mfenced open="(" close=")">
      <mrow>
        <mi>y</mi>
        <mo>+</mo>
        <mrow>
          <mi mathcolor="gray">sin</mi>
          <mo>&#x2061;</mo>
          <mi>x</mi>
        </mrow>
      </mrow>
    </mfenced>
    <mo>&#x2062;</mo>
    <mrow>
      <mo form="prefix">&#x2146;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2062;</mo>
    <mrow>
      <mo form="prefix">&#x2146;</mo>
      <mi>y</mi>
    </mrow>
  </mrow>
</math>

</p>
