;Test script for "Comptest.exe". Written July, 2004, JBM.

;Modified by SLS.  This script doesn't do much anymore.

SetClientPref     1,Sig_digits_rendered,9
SetClientPref     1,Output_differentialD,0
SetClientPref     1,Output_differentiald,0
SetClientPref     1,Output_ln_base,0
SetClientPref     1,Output_imaginaryi,0

Test ID     100
Comment     <mml:math><mml:mn>1.41421356</mml:mn></mml:math>
Client ID   1
Engine      MuPAD
Command ID	Evaluate Numerically
   <mml:math display="inline">
     <mml:mrow>
       <mml:msqrt>
         <mml:mn>2</mml:mn>
       </mml:msqrt>
     </mml:mrow>
   </mml:math>
End of test

Test ID     101
Comment     Render ASCII for e and i
Client ID   1
Engine      MuPAD
Command ID	Evaluate
   <mml:math display="inline">
     <mml:mrow>
       <mml:mi>e</mi>
       <mml:mo>+</mml:mo>
       <mml:mi>&#x2147;</mi>
       <mml:mo>+</mml:mo>
       <mml:mi>i</mi>
       <mml:mo>+</mml:mo>
       <mml:mi>&#x2148;</mi>
     </mml:mrow>
   </mml:math>
End of test



; Comptest creates Client 1 by default - we're creating client 2 here
; The param is the parent of the client to be created

;CreateNextClient  0

SetClientPref     1,Sig_digits_rendered,5
SetClientPref     1,Output_ln_base,1
SetClientPref     1,Output_imaginaryi,2

Test ID     200
Comment     <mml:math><mml:mn>1.4142</mml:mn></mml:math>
;Client ID   2
Client ID   1
Engine      MuPAD
Command ID	Evaluate Numerically
   <mml:math display="inline">
     <mml:mrow>
       <mml:msqrt>
         <mml:mn>2</mml:mn>
       </mml:msqrt>
     </mml:mrow>
   </mml:math>
End of test

Test ID     201
Comment     Render Unicodes for e and i
;Client ID   2
Client ID   1
Engine      MuPAD
