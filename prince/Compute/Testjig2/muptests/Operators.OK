<p>
Test ID 101
</p>
<p>max/min are operators</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <msup>
      <mfenced open="(" close=")">
        <mrow>
          <mi msiMathname="true">max</mi>
          <mo>&#x2061;</mo>
          <mfenced open="(" close=")">
            <mn>2</mn>
            <mn>3</mn>
            <mn>4</mn>
          </mfenced>
          <mo>&#x2212;</mo>
          <mi msiMathname="true">min</mi>
          <mo>&#x2061;</mo>
          <mfenced open="(" close=")">
            <mn>2</mn>
            <mn>3</mn>
            <mn>4</mn>
          </mfenced>
        </mrow>
      </mfenced>
      <mn>2</mn>
    </msup>
  </mrow>
</math>

</p>
