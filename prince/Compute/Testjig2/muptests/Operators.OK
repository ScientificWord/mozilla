          <mo>&#x2212;</mo>
          <mn>1</mn>
        </mrow>
      </msup>
      <mrow>
        <msup>
          <mi>b</mi>
          <mi>a</mi>
        </msup>
        <mo>&#x2062;</mo>
        <mi fontstyle="upright">&#x393;</mi>
        <mo>&#x2061;</mo>
        <mfenced open="(" close=")">
          <mi>a</mi>
        </mfenced>
      </mrow>
    </mfrac>
    <mo>&#x2062;</mo>
    <msup>
      <mi>e</mi>
      <mrow>
        <mfrac>
          <mrow>
            <mrow>
              <mo>&#x2212;</mo>
              <mi>u</mi>
            </mrow>
          </mrow>
          <mi>b</mi>
        </mfrac>
      </mrow>
    </msup>
  </mrow>
</math>

</p>
<p>
Test ID 822
</p>
<p>embellished cot, sec, csc</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mi msiMathname="true">cot</mi>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>2</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2062;</mo>
    <mi msiMathname="true">sec</mi>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>2</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2062;</mo>
    <mi msiMathname="true">csc</mi>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>2</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2212;</mo>
    <mi msiMathname="true">cot</mi>
    <mo>&#x2061;</mo>
    <mi>x</mi>
    <mo>&#x2062;</mo>
    <mi msiMathname="true">sec</mi>
    <mo>&#x2061;</mo>
    <mi>x</mi>
    <mo>&#x2062;</mo>
    <mi msiMathname="true">csc</mi>
    <mo>&#x2061;</mo>
    <mi>x</mi>
  </mrow>
</math>

</p>
<p>
Test ID 826
</p>
<p>sinh, cosh etc</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mi msiMathname="true">sinh</mi>
    <mo>&#x2061;</mo>
    <mi>t</mi>
    <mo>&#x2062;</mo>
    <mi msiMathname="true">sinh</mi>
    <mo>&#x2061;</mo>
    <mrow>
      <mi>t</mi>
      <mo>&#x2062;</mo>
      <mi msiMathname="true">cosh</mi>
      <mo>&#x2061;</mo>
      <mi>t</mi>
    </mrow>
    <mo>+</mo>
    <mi msiMathname="true">cosh</mi>
    <mo>&#x2061;</mo>
    <mrow>
      <mi>t</mi>
      <mo>&#x2062;</mo>
      <mi msiMathname="true">tanh</mi>
      <mo>&#x2061;</mo>
      <mi>t</mi>
      <mo>&#x2062;</mo>
      <mi msiMathname="true">tanh</mi>
      <mo>&#x2061;</mo>
      <mrow>
        <mi>t</mi>
        <mo>&#x2062;</mo>
        <mi msiMathname="true">coth</mi>
        <mo>&#x2061;</mo>
        <mi>t</mi>
      </mrow>
    </mrow>
  </mrow>
</math>

</p>
<p>
Test ID 827
</p>
<p>inverse sinh and cosh etc.</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfrac>
      <mrow>
        <mi msiMathname="true">coth</mi>
        <mo>&#x2061;</mo>
        <mi>x</mi>
      </mrow>
      <mrow>
        <msup>
          <mi msiMathname="true">cosh</mi>
          <mn>&#x2212;1</mn>
        </msup>
        <mo>&#x2061;</mo>
        <mrow>
          <mn>2</mn>
          <mo>&#x2062;</mo>
          <mi>x</mi>
        </mrow>
      </mrow>
    </mfrac>
    <mo>+</mo>
    <mfenced open="(" close=")">
      <mrow>
        <msup>
          <mi msiMathname="true">cosh</mi>
          <mn>&#x2212;1</mn>
        </msup>
        <mo>&#x2061;</mo>
        <mrow>
          <mn>3</mn>
          <mo>&#x2062;</mo>
          <mi>x</mi>
        </mrow>
      </mrow>
    </mfenced>
    <mo>&#x2062;</mo>
    <msup>
      <mi msiMathname="true">sinh</mi>
      <mn>&#x2212;1</mn>
    </msup>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>4</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2062;</mo>
    <msup>
      <mi msiMathname="true">sinh</mi>
      <mn>&#x2212;1</mn>
    </msup>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>5</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>+</mo>
    <mfenced open="(" close=")">
      <mrow>
        <msup>
          <mi msiMathname="true">tanh</mi>
          <mn>&#x2212;1</mn>
        </msup>
        <mo>&#x2061;</mo>
        <mrow>
          <mn>6</mn>
          <mo>&#x2062;</mo>
          <mi>x</mi>
        </mrow>
      </mrow>
    </mfenced>
    <mo>&#x2062;</mo>
    <msup>
      <mi msiMathname="true">tanh</mi>
      <mn>&#x2212;1</mn>
    </msup>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>7</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2062;</mo>
    <mi msiMathname="true">tanh</mi>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>13</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
  </mrow>
</math>

</p>
<p>
Test ID 901
</p>
<p>max/min are operators</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <msup>
      <mfenced open="(" close=")">
        <mrow>
          <mi msiMathname="true">max</mi>
          <mo>&#x2061;</mo>
          <mfenced open="(" close=")">
            <mn>2</mn>
            <mn>3</mn>
            <mn>4</mn>
          </mfenced>
          <mo>&#x2212;</mo>
          <mi msiMathname="true">min</mi>
          <mo>&#x2061;</mo>
          <mfenced open="(" close=")">
            <mn>2</mn>
            <mn>3</mn>
            <mn>4</mn>
          </mfenced>
        </mrow>
      </mfenced>
      <mn>2</mn>
    </msup>
  </mrow>
</math>

</p>
