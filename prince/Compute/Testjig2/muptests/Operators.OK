      <mn>4</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2062;</mo>
    <msup>
      <mi msiMathname="true">sinh</mi>
      <mn>&#x2212;1</mn>
    </msup>
    <mo>&#x2061;</mo>
