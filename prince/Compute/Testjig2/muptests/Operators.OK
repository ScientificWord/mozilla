<p>
Test ID 602
</p>
<p>logical operators</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfenced open="[" close="]">
      <mtable>
        <mtr>
          <mtd>
            <msup>
              <mn>5</mn>
              <mn>6</mn>
            </msup>
            <mo>&#x3c;</mo>
            <msup>
              <mn>6</mn>
              <mn>5</mn>
            </msup>
            <mo>&#x2228;</mo>
            <msup>
              <mn>5</mn>
              <mn>6</mn>
            </msup>
            <mo>&#x3e;</mo>
            <msup>
              <mn>6</mn>
              <mn>5</mn>
            </msup>
            <mo>&#x2228;</mo>
            <mi>&#x3c0;</mi>
            <mo>=</mo>
            <mn>3.14</mn>
          </mtd>
