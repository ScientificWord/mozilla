        <msup>
          <mi msiMathname="true">cosh</mi>
          <mn>&#x2212;1</mn>
        </msup>
        <mo>&#x2061;</mo>
        <mrow>
          <mn>2</mn>
          <mo>&#x2062;</mo>
          <mi>x</mi>
