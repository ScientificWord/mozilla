<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfrac>
      <mrow>
        <mi msiMathname="true">coth</mi>
        <mo>&#x2061;</mo>
        <mi>x</mi>
      </mrow>
      <mrow>
        <msup>
          <mi msiMathname="true">cosh</mi>
          <mn>&#x2212;1</mn>
        </msup>
        <mo>&#x2061;</mo>
        <mrow>
          <mn>2</mn>
          <mo>&#x2062;</mo>
          <mi>x</mi>
        </mrow>
      </mrow>
    </mfrac>
    <mo>+</mo>
    <mfenced open="(" close=")">
      <mrow>
        <msup>
          <mi msiMathname="true">cosh</mi>
          <mn>&#x2212;1</mn>
        </msup>
        <mo>&#x2061;</mo>
        <mrow>
          <mn>3</mn>
          <mo>&#x2062;</mo>
          <mi>x</mi>
        </mrow>
      </mrow>
    </mfenced>
    <mo>&#x2062;</mo>
    <msup>
      <mi msiMathname="true">sinh</mi>
      <mn>&#x2212;1</mn>
    </msup>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>4</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2062;</mo>
    <msup>
      <mi msiMathname="true">sinh</mi>
      <mn>&#x2212;1</mn>
    </msup>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>5</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>+</mo>
    <mfenced open="(" close=")">
      <mrow>
        <msup>
          <mi msiMathname="true">tanh</mi>
          <mn>&#x2212;1</mn>
        </msup>
        <mo>&#x2061;</mo>
        <mrow>
          <mn>6</mn>
          <mo>&#x2062;</mo>
          <mi>x</mi>
        </mrow>
      </mrow>
    </mfenced>
    <mo>&#x2062;</mo>
    <msup>
      <mi msiMathname="true">tanh</mi>
      <mn>&#x2212;1</mn>
    </msup>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>7</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
    <mo>&#x2062;</mo>
    <mi msiMathname="true">tanh</mi>
    <mo>&#x2061;</mo>
    <mrow>
      <mn>13</mn>
      <mo>&#x2062;</mo>
      <mi>x</mi>
    </mrow>
  </mrow>
</math>

</p>
