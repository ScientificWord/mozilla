;Test script for "Comptest.exe". Roughly based on TestDefines.xml
; This version has minimal markup and is meant to mimic how defines work
; in the presence of the Fixup command.

SetClientPref     1,use_mfenced,1

Passthru    <h2>Define f(x)</h2>
Test ID     201 fixup before define
Client ID   1
Engine      MuPAD
Command ID	Fixup
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mi>f</mi>
     <mo>(</mo>
     <mn>5</mn>
     <mo>)</mo>
   </math>
End of test

Test ID     201 eval of fixup before define
Client ID   1
Engine      MuPAD
Command ID	Evaluate
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mrow>
       <mi>f</mi>
       <mo>&#x2062;</mo>
       <mrow>
         <mo>(</mo>
           <mn>5</mn>
         <mo>)</mo>
       </mrow>
     </mrow>
   </math>
End of test

Test ID     201 fixup the definition
Client ID   1
Engine      MuPAD
Command ID	Fixup
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mi>f</mi>
     <mo>(</mo>
     <mi>m</mi>
     <mo>)</mo>
     <mo>=</mo>
     <mfrac>
       <mn>1</mn>
       <mrow>
         <mn>1</mn>
         <mo>+</mo>
         <mi>m</mi>
       </mrow>
     </mfrac>
   </math>
End of test

Test ID     201 define fixup result
Client ID   1
Engine      MuPAD
Command ID	Define
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mrow>
       <mrow>
         <mi>f</mi>
         <mo>&#x2062;</mo>
         <mrow>
           <mo>(</mo>
           <mi>m</mi>
           <mo>)</mo>
         </mrow>
       </mrow>
       <mo>=</mo>
       <mfrac>
         <mn>1</mn>
         <mrow>
           <mn>1</mn>
           <mo>+</mo>
           <mi>m</mi>
         </mrow>
       </mfrac>
     </mrow>
   </math>
End of test

