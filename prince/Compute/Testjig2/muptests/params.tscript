       <mml:mrow>
         <mml:mi>a</mml:mi>
         <mml:mo>&InvisibleTimes;</mml:mo>
         <mml:msup>
           <mml:mi>t</mml:mi>
           <mml:mn>2</mml:mn>
         </mml:msup>
       </mml:mrow>
     </mml:mrow>
   </mml:math>
End of test


