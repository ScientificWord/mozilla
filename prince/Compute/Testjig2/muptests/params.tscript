
;This file contains scripts for computations that require parameters

;Note that it does not test for error conditions such as failure to provide 
;required parameters.

SetEngineState    MuPAD,SeriesOrder,5
SetEngineState    MuPAD,Digits,10
SetEngineState    MuPAD,MaxDegree,4
SetEngineState    MuPAD,PvalOnly,0
SetEngineState    MuPAD,IgnoreSCases,0

SetClientPref     1,use_mfenced,1


Test ID     #100
Comment     Solve ax = 1
Client ID   1
Engine      MuPAD
Command ID	Solve Exact
Param       PID_needvarresult, zPT_ASCII_mmlmarkup,<mi>x</mi>
<math display="inline">
  <mrow>
    <mrow>
      <mi>a</mi>
      <mo>&InvisibleTimes;</mo>
      <mi>x</mi>
    </mrow>
    <mo form="infix">=</mo>
    <mn>1</mn>
  </mrow>
</math>
End of test


; Solve ODE Exact for y'=2
Test ID     #200
Comment     ODE Independent Variable - Solve ODE Exact for y'=2
Client ID   1
Engine      MuPAD
Command ID	Solve ODE Exact
Param       PID_independentvar,zPT_ASCII_mmlmarkup,<mml:math><mml:mi>t</mml:mi></mml:math>
   <mml:math display="inline">
     <mml:mrow>
       <mml:msup>
         <mml:mi>y</mml:mi>
         <mml:mo form="postfix">&prime;</mml:mo>
       </mml:msup>
       <mml:mo form="infix">=</mml:mo>
       <mml:mn>2</mml:mn>
     </mml:mrow>
   </mml:math>
End of test


