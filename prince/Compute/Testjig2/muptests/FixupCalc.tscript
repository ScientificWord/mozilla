Client ID   1
Engine      MuPAD
Command ID	Fixup
   <math xmlns="http://www.w3.org/1998/Math/MathML">
       <msub>
         <mo>D</mo>
         <mi>x</mi>
       </msub>
       <mo>(</mo>
       <msup>
         <mi>x</mi>
         <mn>2</mn>
       </msup>
       <mo>)</mo>
     <mo>+</mo>
       <msub>
         <mo>D</mo>
         <mrow>
           <mi>x</mi>
           <mo>&InvisibleComma;</mo>
           <mi>x</mi>
         </mrow>
       </msub>
       <mo>(</mo>
       <msup>
         <mi>x</mi>
         <mn>4</mn>
       </msup>
       <mo>)</mo>
     <mo>+</mo>
       <msub>
         <mo>D</mo>
         <msup>
           <mi>x</mi>
           <mn>2</mn>
         </msup>
       </msub>
       <mo>(</mo>
       <msup>
         <mi>x</mi>
         <mn>8</mn>
       </msup>
       <mo>)</mo>
   </math>
End of test

