Passthru    <hr/><h3>Now with limits</h3>
Test ID     l213i.3
Client ID   1
Engine      MuPAD
Command ID	Fixup
   <math xmlns="http://www.w3.org/1998/Math/MathML">
     <msubsup>
       <mo largeop="true">&int;</mo>
       <mrow>
         <mo>-</mo>
         <mn>1</mn>
       </mrow>
       <mi>&pi;</mi>
     </msubsup>
     <msubsup>
       <mo largeop="true">&int;</mo>
       <mi>c</mi>
       <mi>d</mi>
     </msubsup>
     <mo>(</mo>
       <mi>y</mi>
       <mo>+</mo>
       <mi mathcolor="gray">sin</mi>
       <mi>x</mi>
     <mo>)</mo>
     <mo>&dd;</mo>
     <mi>x</mi>
     <mo>&dd;</mo>
     <mi>y</mi>
   </math>
End of test

