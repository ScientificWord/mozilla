;Test script for "Comptest.exe". Test all command IDs

SetClientPref     1,use_mfenced,1

Test ID     CCID_Evaluate
Client ID   1
Engine      MuPAD
Command ID	Evaluate
   <mml:math display="inline">
     <mml:mrow>
       <mml:mn>50</mml:mn>
       <mml:mo form="postfix">!</mml:mo>
     </mml:mrow>
   </mml:math>
End of test

Test ID     CCID_Evaluate_Numerically
Client ID   1
Engine      MuPAD
Command ID	Evaluate Numerically
   <mml:math display="inline">
     <mml:mrow>
       <mml:msqrt>
         <mml:mn>2.36</mml:mn>
       </mml:msqrt>
     </mml:mrow>
   </mml:math>
End of test

Test ID     CCID_Simplify
Client ID   1
Engine      MuPAD
Command ID	Simplify
   <mml:math display="inline">
     <mml:mrow>
       <mml:mstyle displaystyle="true" scriptlevel="0">
         <mml:mfrac>
           <mml:msup>
             <mml:mi>a</mml:mi>
             <mml:mi>x</mml:mi>
           </mml:msup>
           <mml:msup>
             <mml:mi>a</mml:mi>
             <mml:mi>y</mml:mi>
           </mml:msup>
         </mml:mfrac>
       </mml:mstyle>
     </mml:mrow>
   </mml:math>
End of test

Test ID     CCID_Combine_Exponentials
Client ID   1
Engine      MuPAD
Command ID	Combine Exponentials
   <mml:math display="inline">
     <mml:mrow>
       <mml:msup>
         <mml:mrow>
           <mml:mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mml:mo>
           <mml:msup>
             <mml:mi>e</mml:mi>
             <mml:mi>x</mml:mi>
           </mml:msup>
           <mml:mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mml:mo>
         </mml:mrow>
         <mml:mi>y</mml:mi>
       </mml:msup>
     </mml:mrow>
   </mml:math>
End of test

Test ID     CCID_Combine_Logs
Client ID   1
Engine      MuPAD
Command ID	Combine Logs
   <mml:math display="inline">
     <mml:mrow>
       <mml:mrow>
         <mml:mi mathcolor="gray">ln</mml:mi>
         <mml:mo>&ApplyFunction;</mml:mo>
         <mml:mrow>
           <mml:mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mml:mo>
           <mml:mrow>
             <mml:mrow>
               <mml:mo form="prefix" fence="true" stretchy="true" symmetric="true">|</mml:mo>
               <mml:mi>x</mml:mi>
               <mml:mo form="postfix" fence="true" stretchy="true" symmetric="true">|</mml:mo>
             </mml:mrow>
             <mml:mo form="infix">+</mml:mo>
             <mml:mn>1</mml:mn>
           </mml:mrow>
           <mml:mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mml:mo>
         </mml:mrow>
       </mml:mrow>
       <mml:mo form="infix">+</mml:mo>
       <mml:mrow>
         <mml:mi mathcolor="gray">ln</mml:mi>
         <mml:mo>&ApplyFunction;</mml:mo>
         <mml:mrow>
           <mml:mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mml:mo>
           <mml:mrow>
             <mml:mrow>
               <mml:mo form="prefix" fence="true" stretchy="true" symmetric="true">|</mml:mo>
               <mml:mi>y</mml:mi>
               <mml:mo form="postfix" fence="true" stretchy="true" symmetric="true">|</mml:mo>
             </mml:mrow>
             <mml:mo form="infix">+</mml:mo>
             <mml:mn>2</mml:mn>
           </mml:mrow>
           <mml:mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mml:mo>
         </mml:mrow>
       </mml:mrow>
     </mml:mrow>
   </mml:math>
End of test

