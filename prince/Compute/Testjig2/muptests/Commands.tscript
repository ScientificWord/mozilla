             <mml:mn>3</mml:mn>
             <mml:mo>&InvisibleTimes;</mml:mo>
             <mml:msup>
               <mml:mi>x</mml:mi>
               <mml:mn>2</mml:mn>
             </mml:msup>
           </mml:mrow>
         </mml:mrow>
         <mml:mo form="infix">,</mml:mo>
         <mml:mrow>
           <mml:mrow>
             <mml:mn>3</mml:mn>
             <mml:mo>&InvisibleTimes;</mml:mo>
             <mml:msup>
               <mml:mi>x</mml:mi>
               <mml:mn>2</mml:mn>
             </mml:msup>
           </mml:mrow>
           <mml:mo form="infix">&minus;</mml:mo>
           <mml:mn>7</mml:mn>
         </mml:mrow>
         <mml:mo form="infix">,</mml:mo>
         <mml:mrow>
           <mml:msup>
             <mml:mi>x</mml:mi>
             <mml:mn>4</mml:mn>
           </mml:msup>
           <mml:mo form="infix">+</mml:mo>
           <mml:mrow>
             <mml:mn>5</mml:mn>
             <mml:mo>&InvisibleTimes;</mml:mo>
             <mml:msup>
               <mml:mi>x</mml:mi>
               <mml:mn>2</mml:mn>
             </mml:msup>
           </mml:mrow>
         </mml:mrow>
       </mml:mrow>
       <mml:mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mml:mo>
