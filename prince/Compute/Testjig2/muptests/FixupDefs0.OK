  <mrow>
    <mn>5</mn>
    <mo>&#x2062;</mo>
    <mi>f</mi>
  </mrow>
</math>

</p>
<p>
Test ID 101 define
</p>
<p>define f(m) = 1/(1+m)</p>
<p>
Test ID 101 eval after define
</p>
