            <mn>7.4831</mn>
            <mo>&#xd7;</mo>
            <msup>
              <mn>10</mn>
              <mn>-2</mn>
            </msup>
          </mtd>
        </mtr>
        <mtr>
          <mtd>
            <mn>7.4831</mn>
            <mo>&#xd7;</mo>
            <msup>
              <mn>10</mn>
              <mn>-2</mn>
