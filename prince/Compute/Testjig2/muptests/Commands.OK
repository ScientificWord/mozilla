      <mn>4704</mn>
      <mn>4</mn>
    </mroot>
  </mrow>
</math>

</p>
<p>
Test ID CCID_Harmonic_Mean
</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfrac>
      <mn>3</mn>
      <mrow>
        <mrow>
          <mfrac>
            <mn>1</mn>
            <mi>a</mi>
          </mfrac>
          <mo>+</mo>
          <mfrac>
            <mn>1</mn>
            <mi>b</mi>
          </mfrac>
          <mo>+</mo>
          <mfrac>
            <mn>1</mn>
            <mi>c</mi>
          </mfrac>
        </mrow>
      </mrow>
    </mfrac>
  </mrow>
</math>

</p>
