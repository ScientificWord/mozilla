;Test script for "Comptest.exe". Roughly based on TestDefines.xml
; This version is mostly straight from SWP export.

SetClientPref     1,use_mfenced,1

; Somewhat questionable.  How does SWP know f is a function?

Test ID     b01 eval before define
Client ID   1
Engine      MuPAD
Command ID	Evaluate
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mrow>
       <mi>f</mi>
       <mo>&ApplyFunction;</mo>
       <mrow>
         <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
         <mn>5</mn>
         <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
       </mrow>
     </mrow>
   </math>
End of test

