        <mi>s</mi>
        <mo>&#x2062;</mo>
        <mrow>
          <mi>cos</mi>
          <mo>&#x2061;</mo>
          <mi>s</mi>
        </mrow>
      </mrow>
      <mo>&#x2062;</mo>
      <mrow>
        <mi>cos</mi>
        <mo>&#x2061;</mo>
        <mi>t</mi>
      </mrow>
    </mrow>
    <mrow>
      <mi>s</mi>
