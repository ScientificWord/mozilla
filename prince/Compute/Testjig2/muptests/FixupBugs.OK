<hr/><h3>New with &lt;mrow></h3>
<p>
Test ID absolute value as fence
</p>
<p>base</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mfenced ilk="enclosed-list" open="[" close="]">
    <mfrac>
      <mn>1</mn>
      <msqrt>
        <mfenced open="(" close=")">
          <mrow>
            <mn>1</mn>
            <mo>+</mo>
            <msup>
              <mfenced open="|" close="|">
                <mrow>
                  <msup>
                    <mi>y</mi>
                    <mn>2</mn>
                  </msup>
                  <mo>-</mo>
                  <msup>
                    <mi>t</mi>
                    <mn>2</mn>
                  </msup>
                </mrow>
              </mfenced>
              <mn>2</mn>
            </msup>
          </mrow>
        </mfenced>
      </msqrt>
    </mfrac>
    <mfrac>
      <mrow>
        <msup>
          <mi>y</mi>
          <mn>2</mn>
        </msup>
        <mo>-</mo>
        <msup>
          <mi>t</mi>
          <mn>2</mn>
        </msup>
      </mrow>
      <msqrt>
        <mfenced open="(" close=")">
          <mrow>
            <mn>1</mn>
            <mo>+</mo>
            <msup>
              <mfenced open="|" close="|">
                <mrow>
                  <msup>
                    <mi>y</mi>
                    <mn>2</mn>
                  </msup>
                  <mo>-</mo>
                  <msup>
                    <mi>t</mi>
                    <mn>2</mn>
                  </msup>
                </mrow>
              </mfenced>
              <mn>2</mn>
            </msup>
          </mrow>
        </mfenced>
      </msqrt>
    </mfrac>
  </mfenced>
</math>

</p>
<p>
Test ID absolute value as fence
</p>
<p>eval the fixup</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mo>[</mo>
    <mrow>
      <mfrac>
        <mn>1</mn>
        <msqrt>
          <msup>
            <mrow>
              <mo>|</mo>
              <mrow>
                <msup>
                  <mi>y</mi>
                  <mn>2</mn>
                </msup>
                <mo>&#x2212;</mo>
                <msup>
                  <mi>t</mi>
                  <mn>2</mn>
                </msup>
              </mrow>
              <mo>|</mo>
            </mrow>
            <mn>2</mn>
          </msup>
          <mo>+</mo>
          <mn>1</mn>
        </msqrt>
      </mfrac>
      <mo>,</mo>
      <mrow>
        <mo>&#x2212;</mo>
        <mfrac>
          <mrow>
            <mo>(</mo>
            <mrow>
              <msup>
                <mi>t</mi>
                <mn>2</mn>
              </msup>
              <mo>&#x2212;</mo>
              <msup>
                <mi>y</mi>
                <mn>2</mn>
              </msup>
            </mrow>
            <mo>)</mo>
          </mrow>
          <msqrt>
            <msup>
              <mrow>
                <mo>|</mo>
                <mrow>
                  <msup>
                    <mi>y</mi>
                    <mn>2</mn>
                  </msup>
                  <mo>&#x2212;</mo>
                  <msup>
                    <mi>t</mi>
                    <mn>2</mn>
                  </msup>
                </mrow>
                <mo>|</mo>
              </mrow>
              <mn>2</mn>
            </msup>
            <mo>+</mo>
            <mn>1</mn>
          </msqrt>
        </mfrac>
      </mrow>
    </mrow>
    <mo>]</mo>
  </mrow>
</math>

</p>
<p>
Test ID absolute value as fence
</p>
<p>fixup the eval result</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mfenced ilk="enclosed-list" open="[" close="]">
    <mfrac>
      <mn>1</mn>
      <msqrt>
        <msup>
          <mfenced open="|" close="|">
            <mrow>
              <msup>
                <mi>y</mi>
                <mn>2</mn>
              </msup>
              <mo>&#x2212;</mo>
              <msup>
                <mi>t</mi>
                <mn>2</mn>
              </msup>
            </mrow>
          </mfenced>
          <mn>2</mn>
        </msup>
        <mo>+</mo>
        <mn>1</mn>
      </msqrt>
    </mfrac>
    <mrow>
      <mo form="prefix">&#x2212;</mo>
      <mfrac>
        <mfenced open="(" close=")">
          <mrow>
            <msup>
              <mi>t</mi>
              <mn>2</mn>
            </msup>
            <mo>&#x2212;</mo>
            <msup>
              <mi>y</mi>
              <mn>2</mn>
            </msup>
          </mrow>
        </mfenced>
        <msqrt>
          <msup>
            <mfenced open="|" close="|">
              <mrow>
                <msup>
                  <mi>y</mi>
                  <mn>2</mn>
                </msup>
                <mo>&#x2212;</mo>
                <msup>
                  <mi>t</mi>
                  <mn>2</mn>
                </msup>
              </mrow>
            </mfenced>
            <mn>2</mn>
          </msup>
          <mo>+</mo>
          <mn>1</mn>
        </msqrt>
      </mfrac>
    </mrow>
  </mfenced>
</math>

</p>
<p>
Test ID absolute value as fence
</p>
<p>eval the eval result</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mo>[</mo>
    <mrow>
      <mfrac>
        <mn>1</mn>
        <msqrt>
          <msup>
            <mrow>
              <mo>|</mo>
              <mrow>
                <msup>
                  <mi>y</mi>
                  <mn>2</mn>
                </msup>
                <mo>&#x2212;</mo>
                <msup>
                  <mi>t</mi>
                  <mn>2</mn>
                </msup>
              </mrow>
              <mo>|</mo>
            </mrow>
            <mn>2</mn>
          </msup>
          <mo>+</mo>
          <mn>1</mn>
        </msqrt>
      </mfrac>
      <mo>,</mo>
      <mrow>
        <mfrac>
          <mrow>
            <mo>(</mo>
            <mrow>
              <msup>
                <mi>t</mi>
                <mn>2</mn>
              </msup>
              <mo>&#x2212;</mo>
              <msup>
                <mi>y</mi>
                <mn>2</mn>
              </msup>
            </mrow>
            <mo>)</mo>
          </mrow>
          <msqrt>
            <msup>
              <mrow>
                <mo>|</mo>
                <mrow>
                  <msup>
                    <mi>y</mi>
                    <mn>2</mn>
                  </msup>
                  <mo>&#x2212;</mo>
                  <msup>
                    <mi>t</mi>
                    <mn>2</mn>
                  </msup>
                </mrow>
                <mo>|</mo>
              </mrow>
              <mn>2</mn>
            </msup>
            <mo>+</mo>
            <mn>1</mn>
          </msqrt>
        </mfrac>
      </mrow>
    </mrow>
    <mo>]</mo>
  </mrow>
</math>

</p>
<p>
Test ID hardBinding
</p>
<p>iterate this</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mfenced ilk="enclosed-list" open="[" close="]">
    <mrow>
      <mrow>
        <mi>s</mi>
        <mo>&#x2062;</mo>
        <mrow>
          <mi>sin</mi>
          <mo>&#x2061;</mo>
          <mi>s</mi>
        </mrow>
      </mrow>
      <mo>&#x2062;</mo>
      <mrow>
        <mi>cos</mi>
        <mo>&#x2061;</mo>
