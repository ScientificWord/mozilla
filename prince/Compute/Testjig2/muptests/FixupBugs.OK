<p>
Test ID brokenVectorField.xhtml
</p>
<p>buggy plot input</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
  <mfenced ilk="enclosed-list" open="(" close=")">
    <mstyle displaystyle="true" scriptlevel="0">
      <mfrac>
        <mn>1</mn>
        <msqrt>
          <mfenced open="(" close=")">
            <mrow>
              <mn>1</mn>
              <mo form="infix">+</mo>
              <msup>
                <mfenced open="|" close="|">
                  <mrow>
                    <msup>
                      <mi>y</mi>
                      <mn>2</mn>
                    </msup>
                    <mo form="infix">-</mo>
                    <msup>
                      <mi>t</mi>
                      <mn>2</mn>
                    </msup>
                  </mrow>
                </mfenced>
                <mn>2</mn>
              </msup>
            </mrow>
          </mfenced>
        </msqrt>
      </mfrac>
    </mstyle>
    <mstyle displaystyle="true" scriptlevel="0">
      <mfrac>
        <mrow>
          <msup>
            <mi>y</mi>
            <mn>2</mn>
          </msup>
          <mo form="infix">-</mo>
          <msup>
            <mi>t</mi>
            <mn>2</mn>
          </msup>
        </mrow>
        <msqrt>
          <mfenced open="(" close=")">
            <mrow>
              <mn>1</mn>
              <mo form="infix">+</mo>
              <msup>
                <mfenced open="|" close="|">
                  <mrow>
                    <msup>
                      <mi>y</mi>
                      <mn>2</mn>
                    </msup>
                    <mo form="infix">-</mo>
                    <msup>
                      <mi>t</mi>
                      <mn>2</mn>
                    </msup>
                  </mrow>
                </mfenced>
                <mn>2</mn>
              </msup>
            </mrow>
          </mfenced>
        </msqrt>
      </mfrac>
    </mstyle>
  </mfenced>
</math>

</p>
<p>
Test ID brokenVectorField.xhtml
</p>
<p>output from Fixup</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML">
  <mrow>
    <mfrac>
      <mn>1</mn>
      <msqrt>
        <msup>
          <mfenced open="|" close="|">
            <mrow>
              <msup>
                <mi>y</mi>
                <mn>2</mn>
              </msup>
              <mo>&#x2212;</mo>
              <msup>
                <mi>t</mi>
                <mn>2</mn>
              </msup>
            </mrow>
          </mfenced>
          <mn>2</mn>
        </msup>
        <mo>+</mo>
        <mn>1</mn>
      </msqrt>
    </mfrac>
    <mo>,</mo>
    <mo>&#x2212;</mo>
    <mfrac>
      <mfenced open="(" close=")">
        <mrow>
          <msup>
            <mi>t</mi>
            <mn>2</mn>
          </msup>
          <mo>&#x2212;</mo>
          <msup>
            <mi>y</mi>
            <mn>2</mn>
          </msup>
        </mrow>
      </mfenced>
      <msqrt>
        <msup>
          <mfenced open="|" close="|">
            <mrow>
              <msup>
                <mi>y</mi>
                <mn>2</mn>
              </msup>
              <mo>&#x2212;</mo>
              <msup>
                <mi>t</mi>
                <mn>2</mn>
              </msup>
            </mrow>
          </mfenced>
          <mn>2</mn>
        </msup>
        <mo>+</mo>
        <mn>1</mn>
      </msqrt>
    </mfrac>
  </mrow>
</math>

