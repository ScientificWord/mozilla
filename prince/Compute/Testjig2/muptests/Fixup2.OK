<hr/><h3>From Operators.tscript</h3>
<p>
Test ID Op101
</p>
<p>max/min are operators</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
  <msup>
    <mfenced open="(" close=")">
      <mrow>
        <mrow>
          <mo mathcolor="gray" form="prefix">max</mo>
          <mfenced ilk="enclosed-list" open="(" close=")">
            <mn>2</mn>
            <mn>3</mn>
            <mn>4</mn>
          </mfenced>
        </mrow>
        <mo form="infix">&#x2212;</mo>
        <mrow>
          <mo mathcolor="gray" form="prefix">min</mo>
          <mfenced ilk="enclosed-list" open="(" close=")">
            <mn>2</mn>
            <mn>3</mn>
            <mn>4</mn>
          </mfenced>
        </mrow>
      </mrow>
    </mfenced>
    <mn>2</mn>
  </msup>
</math>

</p>
