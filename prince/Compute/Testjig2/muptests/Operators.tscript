;Test script for "Comptest.exe".

;Originally from Operators.tex.
;    This document attempts to use all operators and trig-type functions
; known to the Prince computation system.

SetClientPref     1,use_mfenced,1

Test ID     101
Comment     max/min are operators
Client ID   1
Engine      MuPAD
Command ID	Interpret
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mrow>
       <msup>
         <mrow>
           <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
           <mrow>
             <mrow>
               <mo mathcolor="gray" form="prefix">max</mo>
               <mrow>
                 <mo form="prefix" fence="true" stretchy="false">(</mo>
                 <mrow>
                   <mn>2</mn>
                   <mo form="infix">,</mo>
                   <mn>3</mn>
                   <mo form="infix">,</mo>
                   <mn>4</mn>
                 </mrow>
                 <mo form="postfix" fence="true" stretchy="false">)</mo>
               </mrow>
             </mrow>
             <mo form="infix">&minus;</mo>
             <mrow>
               <mo mathcolor="gray" form="prefix">min</mo>
               <mrow>
                 <mo form="prefix" fence="true" stretchy="false">(</mo>
                 <mrow>
                   <mn>2</mn>
                   <mo form="infix">,</mo>
                   <mn>3</mn>
                   <mo form="infix">,</mo>
                   <mn>4</mn>
                 </mrow>
                 <mo form="postfix" fence="true" stretchy="false">)</mo>
               </mrow>
             </mrow>
           </mrow>
           <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
         </mrow>
         <mn>2</mn>
       </msup>
     </mrow>
   </math>
End of test

