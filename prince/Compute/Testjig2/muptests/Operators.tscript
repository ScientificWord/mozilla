     <mrow>
       <mrow>
         <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
         <mrow>
           <mn>1</mn>
           <mo form="infix">+</mo>
           <msubsup>
             <mrow>
               <mo form="prefix" fence="true" stretchy="true" symmetric="true">[</mo>
               <mfrac>
                 <mn>2</mn>
