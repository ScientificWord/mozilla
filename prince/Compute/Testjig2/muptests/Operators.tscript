Test ID     108
Comment     logic
Client ID   1
Engine      MuPAD
Command ID	Interpret
   <math xmlns="http://www.w3.org/1998/Math/MathML">
     <mrow>
       <mrow>
         <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
         <mrow>
           <mrow>
             <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
             <mrow>
               <mrow>
                 <mo form="prefix" fence="true" stretchy="true" symmetric="true">{</mo>
                 <mrow>
                   <mn>1</mn>
                   <mo form="infix">,</mo>
                   <mn>2</mn>
                   <mo form="infix">,</mo>
                   <mn>3</mn>
                   <mo form="infix">,</mo>
                   <mi>c</mi>
                 </mrow>
                 <mo form="postfix" fence="true" stretchy="true" symmetric="true">}</mo>
               </mrow>
               <mo form="infix">&cap;</mo>
               <mrow>
                 <mo form="prefix" fence="true" stretchy="true" symmetric="true">{</mo>
                 <mrow>
                   <mn>2</mn>
                   <mo form="infix">,</mo>
                   <mn>4</mn>
                   <mo form="infix">,</mo>
                   <mn>6</mn>
                 </mrow>
                 <mo form="postfix" fence="true" stretchy="true" symmetric="true">}</mo>
               </mrow>
             </mrow>
             <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
           </mrow>
           <mo form="infix">&cup;</mo>
           <mrow>
             <mo form="prefix" fence="true" stretchy="true" symmetric="true">(</mo>
             <mrow>
               <mrow>
                 <mo form="prefix" fence="true" stretchy="true" symmetric="true">{</mo>
                 <mrow>
                   <mn>1</mn>
                   <mo form="infix">,</mo>
                   <mn>2</mn>
                   <mo form="infix">,</mo>
                   <mn>3</mn>
                   <mo form="infix">,</mo>
                   <mi>c</mi>
                 </mrow>
                 <mo form="postfix" fence="true" stretchy="true" symmetric="true">}</mo>
               </mrow>
               <mo form="infix">&cap;</mo>
