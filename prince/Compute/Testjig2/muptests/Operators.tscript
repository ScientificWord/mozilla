Test ID     103
Comment     gcd/lcm
Client ID   1
Engine      MuPAD
Command ID	Interpret
   <math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
     <mrow>
       <mo mathcolor="gray" form="prefix">gcd</mo>
       <mrow>
         <mrow>
           <mo form="prefix" fence="true" stretchy="false">(</mo>
           <mrow>
             <mrow>
               <msup>
                 <mi>x</mi>
                 <mn>2</mn>
               </msup>
               <mo form="infix">+</mo>
               <mn>1</mn>
             </mrow>
             <mo form="infix">,</mo>
             <mrow>
               <mi>x</mi>
               <mo form="infix">+</mo>
               <mn>1</mn>
             </mrow>
           </mrow>
           <mo form="postfix" fence="true" stretchy="false">)</mo>
         </mrow>
       </mrow>
     </mrow>
     <mo form="infix">&sdot;</mo>
	 <mrow>
	   <mi mathcolor="gray">lcm</mi>
	   <mo>&ApplyFunction;</mo>
	   <mrow>
		 <mo form="prefix" fence="true" stretchy="false">(</mo>
		 <mrow>
		   <mrow>
			 <msup>
			   <mi>x</mi>
			   <mn>2</mn>
			 </msup>
			 <mo form="infix">+</mo>
			 <mn>1</mn>
		   </mrow>
		   <mo form="infix">,</mo>
		   <mrow>
			 <mi>x</mi>
			 <mo form="infix">+</mo>
			 <mn>1</mn>
		   </mrow>
		 </mrow>
		 <mo form="postfix" fence="true" stretchy="false">)</mo>
	   </mrow>
	 </mrow>
   </math>
End of test

Test ID     104
Comment     Floor/Ceiling
Client ID   1
Engine      MuPAD
Command ID	Interpret
   <math xmlns="http://www.w3.org/1998/Math/MathML">
     <mrow>
       <mrow>
         <mo form="prefix" fence="true" stretchy="true" symmetric="true">&LeftFloor;</mo>
         <mfrac>
           <mn>123</mn>
           <mn>34</mn>
         </mfrac>
         <mo form="postfix" fence="true" stretchy="true" symmetric="true">&RightFloor;</mo>
       </mrow>
       <mo form="infix">+</mo>
       <mrow>
         <mo form="prefix" fence="true" stretchy="true" symmetric="true">&LeftCeiling;</mo>
         <mfrac>
           <mn>123</mn>
           <mn>34</mn>
         </mfrac>
         <mo form="postfix" fence="true" stretchy="true" symmetric="true">&RightCeiling;</mo>
       </mrow>
       <mo form="infix">&minus;</mo>
       <msubsup>
         <mrow>
           <mo form="prefix" fence="true" stretchy="true" symmetric="true">[</mo>
           <mfrac>
             <mn>123</mn>
             <mrow>
               <mn>34</mn>
               <mo>&InvisibleTimes;</mo>
               <mi>n</mi>
             </mrow>
           </mfrac>
           <mo form="postfix" fence="true" stretchy="true" symmetric="true">]</mo>
         </mrow>
         <mn>1</mn>
         <mn>2</mn>
       </msubsup>
     </mrow>
   </math>
End of test

