             <mo>(</mo>
             <mfrac>
               <mn>2</mn>
               <mrow>
                 <mn>3</mn>
                 <mi>x</mi>
               </mrow>
             </mfrac>
             <mo>)</mo>
           </mrow>
         <mo>]</mo>
       </mrow>
       <mrow>
         <mi>x</mi>
         <mo>=</mo>
