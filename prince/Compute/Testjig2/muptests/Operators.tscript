                 <mrow>
                   <mi>a</mi>
                   <mo form="infix">,</mo>
                   <mi>b</mi>
                   <mo form="infix">,</mo>
                   <mi>c</mi>
                 </mrow>
                 <mo form="postfix" fence="true" stretchy="true" symmetric="true">}</mo>
               </mrow>
             </mrow>
             <mo form="postfix" fence="true" stretchy="true" symmetric="true">)</mo>
