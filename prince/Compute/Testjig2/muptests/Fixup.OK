    <mo form="infix">&#x2212;</mo>
    <mn>4</mn>
  </mrow>
</math>

</p>
<p>
Test ID 102
</p>
<p>should build mfrac</p>
<p>
<math xmlns="http://www.w3.org/1998/Math/MathML" display="inline">
  <mrow>
    <mrow>
      <mi mathcolor="gray">sin</mi>
      <mo>&#x2061;</mo>
      <mi>a</mi>
    </mrow>
    <mo form="infix">/</mo>
    <mrow>
      <mi mathcolor="gray">sin</mi>
      <mo>&#x2061;</mo>
      <mi>b</mi>
    </mrow>
  </mrow>
</math>

</p>
