DEPTH		= ../../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

IS_COMPONENT	= 1
MODULE		    = mupadenginewrapper
LIBRARY_NAME	= mupadenginewrapper
XPIDL_MODULE	= mupadenginewrapper
SHORT_LIBNAME	= mupwrap

MODULE_NAME	= msiMuPADEngineWrapperModule

REQUIRES	= \
      string \
		  xpcom \
		  enginewrapper \
		  $(NULL)

CPPSRCS		=		   \
		msiMuPADEngineWrapper.cpp	   \
		msiMuPADEngineWrapperModule.cpp \
		$(NULL)

include $(topsrcdir)/config/config.mk

# separate libraries linked in.
EXTRA_DSO_LDOPTS = \
      $(DIST)/lib/$(LIB_PREFIX)MuPWrapperDLL_s.$(LIB_SUFFIX) \
      $(DIST)/lib/$(LIB_PREFIX)computelib_s.$(LIB_SUFFIX) \
      $(DIST)/lib/$(LIB_PREFIX)enginelib_s.$(LIB_SUFFIX) \
      $(DIST)/lib/$(LIB_PREFIX)libtci_s.$(LIB_SUFFIX) \
	    $(XPCOM_GLUE_LDOPTS) \
	    $(NSPR_LIBS) \
		$(NULL)

ifeq ($(OS_ARCH),WINNT)
EXTRA_LIBS += \
		ole32.lib \
		oleaut32.lib \
		oledlg.lib \
    $(srcdir)/../../MuPAD/win32/mupkernel.lib \
    $(NULL)
endif

ifeq ($(OS_ARCH),Darwin)
EXTRA_LIBS += \
		$(srcdir)/../../MuPAD/Darwin/libexpat.a \
		$(srcdir)/../../MuPAD/Darwin/liblibstream.a \
		$(srcdir)/../../MuPAD/Darwin/libmupudskernel.a \
		$(srcdir)/../../MuPAD/Darwin/libmut.a \
		-lz -framework Carbon \
		$(NULL)
endif

ifeq ($(OS_ARCH),Linux)
EXTRA_LIBS += \
		$(srcdir)/../../MuPAD/linux/libmupudskernel.a \
		$(srcdir)/../../MuPAD/linux/libexpat.a \
		$(srcdir)/../../MuPAD/linux/libmut.a \
		$(srcdir)/../../MuPAD/linux/liblibstream.a \
		$(srcdir)/../../MuPAD/linux/libz.a \
		$(NULL)
endif

include $(topsrcdir)/config/rules.mk

LOCAL_INCLUDES = -I$(srcdir)/../../libtci	\
			-I$(srcdir)/../../Engines	\
			-I$(srcdir)/../../Engines/MuPAD	\
      -I$(srcdir)/../../computelib \
      -I$(srcdir)/../../compsample2 \
      -I$(srcdir)/../../wrappers \
			$(NULL)

                 