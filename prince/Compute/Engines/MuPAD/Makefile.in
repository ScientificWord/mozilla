DEPTH		= ../../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

MODULE = compute
LIBRARY_NAME	= MuPWrapperDLL_s

include $(topsrcdir)/config/config.mk

CPPSRCS =				\
  MuAnalyzer.cpp \
  mupd_eng.cpp \
  MuP2Tree.cpp \
  MuWrap.cpp \
  MuWrapPlotCmd.cpp \
  MuPADPlot.cpp \
	$(NULL)

# we don't want the shared lib, but we want to force the creation of a static lib.
FORCE_STATIC_LIB = 1

LOCAL_INCLUDES	= -I$(srcdir)/../../libtci

ifeq ($OS_ARCH),WINNT)
EXTRA_LIBS += \
		ole32.lib \
		oleaut32.lib \
		oledlg.lib \
		$(srcdir)/mupkernel.lib \
		$(NULL)
endif
ifeq ($OS_ARCH),Darwin)
EXTRA_LIBS += \
		$(srcdir)/../../MuPAD/libexpat.a \
		$(srcdir)/../../MuPAD/liblibstream.a \
		$(srcdir)/../../MuPAD/libmupudskernel.a \
		$(srcdir)/../../MuPAD/libmut.a \
		$(NULL)
endif

include $(topsrcdir)/config/rules.mk

