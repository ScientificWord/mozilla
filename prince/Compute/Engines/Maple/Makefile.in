DEPTH		= ../../../..
topsrcdir	= @top_srcdir@
srcdir		= @srcdir@
VPATH		= @srcdir@

include $(DEPTH)/config/autoconf.mk

MODULE = compute
LIBRARY_NAME	= MplWrapperDLL
SHORT_LIBNAME	= MplWrapperDLL
MODULE_NAME		= compute

include $(topsrcdir)/config/config.mk

CPPSRCS =				\
  eAnalyzer.cpp \
  mapl_eng.cpp \
  Mpl2Tree.cpp \
  MplWrap.cpp \
	$(NULL)

# we don't want the shared lib, but we want to force the creation of a static lib.
FORCE_STATIC_LIB = 1

LOCAL_INCLUDES	= -I$(srcdir)/../../libtci

SHARED_LIBRARY_LIBS += \
      $(DIST)/lib/computelib.$(LIB_SUFFIX) \
      $(DIST)/lib/enginelib.$(LIB_SUFFIX) \
      $(DIST)/lib/libtci.$(LIB_SUFFIX) \
			$(NULL)

include $(topsrcdir)/config/rules.mk

CXXFLAGS	+= /DMOZILLA_VERSION=\"$(MOZILLA_VERSION)\"
